# Copy to .env and edit. Never commit .env.

APP_NAME=book-rag
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/index.db

# --- Step 2: chunking ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Step 3: embeddings ---
# sentence-transformers (local, default) or openai
EMBEDDING_BACKEND=sentence-transformers
# all-MiniLM-L6-v2: 384-dim, no query prefix, fast on CPU
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
EMBEDDING_BATCH=64

# --- Step 5: retrieval + rerank + answering ---
CANDIDATE_K=30
TOP_K=5
HYBRID_ALPHA=0.6
MIN_SCORE=0.20
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# extractive (no API key), gemini, or openai
LLM_BACKEND=extractive
LLM_MODEL=gemini-2.0-flash

# Only needed for LLM_BACKEND=gemini
# GEMINI_API_KEY=

# Only needed for LLM_BACKEND=openai or EMBEDDING_BACKEND=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
