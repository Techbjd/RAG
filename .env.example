# Copy to .env and edit. Never commit .env.

APP_NAME=book-rag
DATA_DIR=./data

# --- API: uploads ---
# Comma-separated extensions accepted by POST /api/books.
UPLOAD_SUFFIXES=.pdf,.txt,.md,.json
# Reject files larger than this (megabytes).
MAX_UPLOAD_MB=50

# --- Postgres + pgvector (docker compose up -d) ---
# These three are also read by compose.yaml.
POSTGRES_USER=bookrag
POSTGRES_PASSWORD=bookrag_dev
POSTGRES_DB=bookrag
DATABASE_URL=postgresql+psycopg://bookrag:bookrag_dev@127.0.0.1:5433/bookrag
# All book-rag tables live in this schema; public stays untouched.
DATABASE_SCHEMA=book_rag
# SQLAlchemy pool (PostgreSQL only). Set explicitly for predictable live capacity.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
# Max simultaneous embed/rerank/LLM jobs; extra queries wait for a slot.
MAX_CONCURRENT_QUERIES=4

# --- Step 2: chunking ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Step 3: embeddings ---
# sentence-transformers (local, default) or openai
EMBEDDING_BACKEND=sentence-transformers
# all-MiniLM-L6-v2: 384-dim, no query prefix, fast on CPU
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
EMBEDDING_BATCH=64

# --- Step 5: retrieval + rerank + answering ---
CANDIDATE_K=30
TOP_K=5
HYBRID_ALPHA=0.6
MIN_SCORE=0.20
# Soft cap per chapter; 0 disables the cap.
MAX_PER_CHAPTER=4
# Cosine similarity at/above which two chunks are treated as duplicates.
DEDUPE_SIMILARITY=0.92
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# extractive (no API key), gemini, or openai
LLM_BACKEND=extractive
LLM_MODEL=gemini-2.0-flash

# Only needed for LLM_BACKEND=gemini
# GEMINI_API_KEY=

# Only needed for LLM_BACKEND=openai or EMBEDDING_BACKEND=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
