# Copy to .env and edit. Never commit .env.

APP_NAME=book-rag
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/index.db

# --- Step 2: chunking ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Step 3: embeddings ---
# sentence-transformers (local, default) or openai
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_BATCH=64

# --- Step 5: retrieval + answering ---
TOP_K=5
HYBRID_ALPHA=0.6
MIN_SCORE=0.20

# extractive (no API key) or openai
LLM_BACKEND=extractive
LLM_MODEL=gpt-4o-mini

# Only needed for LLM_BACKEND=openai or EMBEDDING_BACKEND=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
